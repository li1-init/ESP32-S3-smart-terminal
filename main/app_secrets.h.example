/* ==========================================================================
 *  app_secrets.h.example  ——  密钥模板（这个文件会提交到 GitHub）
 *
 *  使用方法：
 *    1. 复制本文件为 app_secrets.h（同目录）
 *    2. 把下面的 xxxx 换成自己的密钥
 *    3. app_secrets.h 已被 .gitignore 忽略，不会上传；不要 git add -f
 *
 *  三个密钥都可以免费申请：
 *    DeepSeek  https://platform.deepseek.com/
 *    心知天气   https://www.seniverse.com/
 *    OneNET    https://open.iot.10086.cn/
 * ========================================================================== */
#pragma once

/* DeepSeek 大模型 API Key（AI 问答页用） */
#define DEEPSEEK_API_KEY "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

/* 心知天气 API Key（天气页用，免费版够用） */
#define SENIVERSE_KEY "xxxxxxxxxxx"

/* OneNET 设备接入信息（产品 → 设备详情里能看到） */
#define ONENET_PRODUCT_ID  "xxxxxxxxxx"
#define ONENET_ACCESS_KEY "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="
#define ONENET_DEVICE_NAME "esp32led02"

/* 兜底 WiFi：设备 NVS 里没有配网记录时才会尝试连接（配网页配过就用配网页的）
 * 没有可以留空："" */
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
